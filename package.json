{
  "name": "shree-gajanand-india-website",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready website for Shree Gajanand India Pvt. Ltd.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check public/script.js",
