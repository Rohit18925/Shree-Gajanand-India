{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shree-gajanand-india",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-19",

  "secrets": {
    "required": ["RESEND_API_KEY"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgi-ecms",
      "database_id": "82e6dec8-39f8-4d48-b195-74952a9f84e8"
    }
  ],

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  }
}